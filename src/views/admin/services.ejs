<%- include("../partials/head", { title }) %>
<%- include("../partials/header") %>
<%- include("../partials/flash") %>

<main class="page">
  <section class="card">
    <div class="dashboard-header">
      <div>
        <p class="eyebrow">Admin</p>
        <h1>Servicii</h1>
        <p>Adaugă, modifică sau dezactivează serviciile disponibile pentru programări.</p>
      </div>

      <a href="/admin/dashboard" class="button">Înapoi la dashboard</a>
    </div>

    <form action="/admin/servicii" method="POST" class="form service-create-form">
      <h2>Adaugă serviciu nou</h2>

      <label>
        Nume serviciu
        <input type="text" name="name" placeholder="Ex: Tuns + barbă" required />
      </label>

      <label>
        Descriere
        <textarea name="description" rows="3" placeholder="Descriere scurtă a serviciului"></textarea>
      </label>

      <div class="form-grid-2">
        <label>
          Durată în minute
          <input type="number" name="durationMinutes" min="1" step="1" placeholder="45" required />
        </label>

        <label>
          Preț
          <input type="number" name="price" min="0" step="0.01" placeholder="80" required />
        </label>
      </div>

      <button type="submit" class="button">Adaugă serviciul</button>
    </form>
  </section>

  <section class="card services-section">
    <h2>Servicii existente</h2>

    <% if (services.length > 0) { %>
      <div class="services-list">
        <% services.forEach((service) => { %>
          <article class="service-admin-card <%= service.isActive ? "" : "is-inactive" %>">
            <form action="/admin/servicii/<%= service.id %>/update" method="POST" class="form">
              <div class="service-card-top">
                <div>
                  <h3><%= service.name %></h3>
                  <p class="status">
                    <%= service.isActive ? "Activ" : "Inactiv" %>
                  </p>
                </div>

                <form action="/admin/servicii/<%= service.id %>/toggle" method="POST"></form>
              </div>

              <label>
                Nume serviciu
                <input type="text" name="name" value="<%= service.name %>" required />
              </label>

              <label>
                Descriere
                <textarea name="description" rows="3"><%= service.description || "" %></textarea>
              </label>

              <div class="form-grid-2">
                <label>
                  Durată în minute
                  <input
                    type="number"
                    name="durationMinutes"
                    min="1"
                    step="1"
                    value="<%= service.durationMinutes %>"
                    required
                  />
                </label>

                <label>
                  Preț
                  <input
                    type="number"
                    name="price"
                    min="0"
                    step="0.01"
                    value="<%= service.price %>"
                    required
                  />
                </label>
              </div>

              <div class="service-actions">
                <button type="submit" class="button">Salvează modificările</button>
              </div>
            </form>

            <div class="service-card-top">
                <div>
                     <h3><%= service.name %></h3>
                        <p class="status">
                        <%= service.isActive ? "Activ" : "Inactiv" %>
                        </p>
                </div>
            </div>

          </article>
        <% }) %>
      </div>
    <% } else { %>
      <p>Nu există servicii adăugate.</p>
    <% } %>
  </section>
</main>

<%- include("../partials/footer") %>