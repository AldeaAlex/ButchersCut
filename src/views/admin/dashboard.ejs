<%- include("../partials/head", { title }) %>
<%- include("../partials/header") %>
<%- include("../partials/flash") %>

<main class="page">
  <section class="card">
    <div class="dashboard-header">
      <div>
        <p class="eyebrow">Admin dashboard</p>
        <h1>Programări</h1>
        <p>Vezi și administrează programările pentru ziua selectată.</p>
      </div>

      <a href="/admin/programare-noua" class="button">Programează client</a>
    </div>

    <form action="/admin/dashboard" method="GET" class="date-filter">
      <label>
        Selectează ziua
        <input
          type="date"
          name="date"
          value="<%= selectedDate %>"
          onchange="this.form.submit()"
        />
      </label>
    </form>

    <% if (appointments.length > 0) { %>
      <div class="appointments-list">
        <% appointments.forEach((appointment) => { %>
          <article class="appointment-card appointment-status-<%= appointment.status.toLowerCase() %>">
            <div class="appointment-time">
              <strong><%= appointment.displayStartTime %></strong>
              <span><%= appointment.displayEndTime %></span>
            </div>

            <div>
              <h3><%= appointment.clientName %></h3>
              <p><strong>Serviciu:</strong> <%= appointment.service.name %></p>
              <p><strong>Telefon:</strong> <%= appointment.clientPhone %></p>

              <% if (appointment.clientEmail) { %>
                <p><strong>Email:</strong> <%= appointment.clientEmail %></p>
              <% } %>

              <% if (appointment.notes) { %>
                <p><strong>Notițe:</strong> <%= appointment.notes %></p>
              <% } %>
            </div>

            <div class="appointment-admin-actions">
              <span class="status"><%= appointment.displayStatus %></span>

              <form action="/admin/programari/<%= appointment.id %>/status" method="POST" class="status-form">
                <input type="hidden" name="selectedDate" value="<%= selectedDate %>" />

                <select name="status" onchange="this.form.submit()">
                  <option value="CONFIRMED" <%= appointment.status === "CONFIRMED" ? "selected" : "" %>>
                    Confirmată
                  </option>
                  <option value="COMPLETED" <%= appointment.status === "COMPLETED" ? "selected" : "" %>>
                    Finalizată
                  </option>
                  <option value="CANCELLED" <%= appointment.status === "CANCELLED" ? "selected" : "" %>>
                    Anulată
                  </option>
                  <option value="NO_SHOW" <%= appointment.status === "NO_SHOW" ? "selected" : "" %>>
                    Neprezentat
                  </option>
                </select>
              </form>
            </div>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <p>Nu există programări pentru ziua selectată.</p>
    <% } %>
  </section>
</main>

<script src="/js/dashboard.js"></script>

<%- include("../partials/footer") %>